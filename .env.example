# 复制为 .env 后填写自己的密钥；本文件不包含真实认证信息。

# 百炼：业务节点按快思考、深思考分类，Max 单独用于评测。
DASHSCOPE_API_KEY=
# Max 系列单独作为评测模型。
QWEN3_MAX_MODEL=["qwen3-max","qwen3.7-max-2026-06-08"]
# 模型按 JSON 数组顺序调用，免费额度耗尽时尝试下一项。
DEEP_THINK_MODELS=["qwen3.7-plus","qwen3.5-122b-a10b","qwen3.5-plus-2026-02-15","qwen3.6-plus","qwen3.5-397b-a17b"]
QUICK_THINK_MODELS=["qwen3.6-flash","qwen3.7-flash-2026-07-15","qwen3.5-flash","qwen3.8-flash","qwen3.5-flash-2026-02-23","qwen3.6-flash-2026-04-16","qwen-flash","qwen3.7-flash"]
VISION_MODEL=qwen3.5-ocr

# 硅基流动用于向量、重排模型。
# 知识库：变更模型或维度时，应使用匹配的新索引。
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_MULTI_QUERY=false

# 主题研究的网页搜索与浏览器取证。
BOCHA_API_KEY=
BROWSER_HEADLESS=true

# 按实际使用的加密资产分析维度填写数据源密钥。
FRED_API_KEY=
CMC_PRO_API_KEY=
EODHD_API_KEY=
CRYPTO_ETF_MCP_API_KEY=

# 独立评测写入 Langfuse 时使用。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# 日志配置；路径、候选采集等其他参数见 app/core/config.py。
LOG_JSON=true
LOG_LEVEL=INFO
LOG_DIR=logs
